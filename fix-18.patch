+/* SPDX-License-Identifier: GPL-3.0-only */
+/* SLOOP 2.8.3: a sample (SAMPLE, SLICE) played again on a voice still sounding starts over from silence, with its ATK
+ * (voice.c voice_start, VP_ON). A user's chopped breaks with ATK set to soften the chops' starts: the attack worked
+ * only on different notes in POLY; the same note again in POLY, and every note in MONO / LEGATO / UNISON, started at
+ * the level the voice had (a click, ATK ignored). Checks, per voice mode: the second chop's level over its first
+ * blocks (it starts low and rises with ATK), and the largest step between two output samples around its start
+ * against the largest within the chop (no click). LEGATO with the first chop still held glides on by design.
+ * Exit status: the number of failed checks. */
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+static int fails;
+static void check(int ok, const char *what) { printf("chop: %-74s %s\n", what, ok ? "ok" : "FAIL"); fails += !ok; }
+static int32_t outb[CTL * 2];
+static int32_t jump_max, last;
+static void block(void)
+{
+    uint32_t i;
+    mix_block(outb, CTL);
+    for (i = 0; i < CTL; i++) {
+        int32_t d = outb[2 * i] - last;
+        d = d < 0 ? -d : d;
+        if (d > jump_max) jump_max = d;
+        last = outb[2 * i];
+    }
+}
+static voice_t *voice_of(track_t *t, uint32_t n)
+{
+    uint32_t i;
+    for (i = 0; i < NVOICE; i++)
+        if ((t->v[i].active || t->v[i].pend) && t->v[i].note == n)
+            return &t->v[i];
+    return 0;
+}
+static void run(int mode, uint32_t n1, uint32_t n2, const char *what)
+{
+    track_t *t = &trk[1];
+    uint32_t k;
+    double lv[8];
+    int32_t steady, start;
+    char b[200];
+    host_tracks_init();
+    host_preset(t, 4, 0);                               /* SAMPLE */
+    for (k = 0; k < NVOICE; k++) memset(&t->v[k], 0, sizeof t->v[k]);
+    t->nmono = 0; t->mono_note = 0;
+    t->p[P_VOICE] = (int16_t)mode;
+    t->p[P_ATK] = 60; t->p[P_SUS] = 127; t->p[P_REL] = 90;
+    for (k = 0; k < 8; k++) block();
+    trk_note_on(t, n1, 100);
+    for (k = 0; k < 40; k++) block();
+    jump_max = 0;
+    for (k = 0; k < 80; k++) block();                   /* the chop as it plays: its own largest step */
+    steady = jump_max;
+    trk_note_off(t, n1);
+    for (k = 0; k < 3; k++) block();                    /* its release still sounding */
+    jump_max = 0;
+    trk_note_on(t, n2, 100);
+    for (k = 0; k < 8; k++) {
+        voice_t *v;
+        block();
+        v = voice_of(t, n2);
+        lv[k] = v && v->active && v->stage != 4u ? v->env * 100.0 / (1 << 24) : -1.0;
+    }
+    start = jump_max;
+    snprintf(b, sizeof b, "%s: the 2nd chop starts from silence with its ATK (%.1f %% .. %.1f %%)", what, lv[2], lv[7]);
+    check(lv[2] >= 0 && lv[2] < 5.0 && lv[7] > lv[2], b);
+    snprintf(b, sizeof b, "%s: no click at its start (largest step %d, in the chop %d)", what, start, steady);
+    check(start <= steady + steady / 4, b);
+}
+int main(void)
+{
+    run(V_POLY, 60, 60, "POLY, the same chop again");
+    run(V_POLY, 60, 62, "POLY, another chop");
+    run(V_MONO, 60, 62, "MONO, another chop");
+    run(V_LEGATO, 60, 62, "LEGATO, another chop");
+    run(V_UNISON, 60, 62, "UNISON, another chop");
+    printf("chop: %d failed\n", fails);
+    return fails;
+}
diff --git a/tests/drum_steal_test.c b/tests/drum_steal_test.c
new file mode 100644
index 0000000..0788e50
--- /dev/null
+++ b/tests/drum_steal_test.c
@@ -0,0 +1,98 @@
+/* SLOOP 2.8.3: drum voices on a busy beat (kick on the beat, 16th hats, open hats, snare + clap, crash, ride, a tom
+ * fill), every kit: no kick is cut short by another sound taking its voice (NDRUM voices; up to 2.8.2 the oldest went,
+ * kick or not: 11 to 13 kicks of 16 cut on the 808, GM and AMBIENT kits; a tester's report). A kick re-hit while it
+ * still sounds may take its own voice (as on a drum machine). Exit status: the kits that fail */
+#define FELUCCA_ARRANGER 1
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+#define PROJ_HOST 1
+static uint32_t trk_def_engine(uint32_t i) { return i < NPART ? i : 0; }
+#include "../firmware/src/project.c"
+static struct { uint8_t force; } ui;
+static uint8_t sync_reload;
+#include "../firmware/src/arranger_scene.c"
+static void block(void) { int32_t out[CTL * 2]; mix_block(out, CTL); }
+typedef struct { uint32_t age, start, alive; } kk_t;
+static uint32_t early, hits, lost, lostk;
+static uint32_t slot_age[16], slot_t0[16];
+static uint32_t run_kit(uint32_t kit, int dense, uint32_t *kicks, uint32_t *natural_ms)
+{
+    uint32_t step, b, i, cut = 0, nk = 0, SB = FS / 8u / CTL, now = 0;
+    kk_t k[64];
+    memset(&drums, 0, sizeof drums);
+    drums.set = -2;
+    TDRUM->p[P_E0] = (int16_t)kit;
+    TDRUM->p[P_MUTE] = 0;
+    for (i = 0; i < 20; i++) block();
+    /* the kick alone: how long it sounds */
+    drum_on(36, 110);
+    for (b = 0; b < FS * 2u / CTL; b++) { int a = 0; for (i = 0; i < NDRUM; i++) a |= drums.v[i].active && drums.v[i].note == 36; if (!a) break; block(); }
+    *natural_ms = b * CTL * 1000u / FS;
+    for (i = 0; i < 40; i++) block();
+    for (step = 0; step < 64; step++) {
+        uint32_t s = step % 16;
+        uint8_t notes[10]; uint32_t n = 0;
+        if (s % 4 == 0) notes[n++] = 36;                     /* kick */
+        if (dense) {
+            if (s == 0) notes[n++] = 49;                     /* crash, each bar */
+            if (s == 4 || s == 12) { notes[n++] = 38; notes[n++] = 39; }   /* snare + clap */
+            notes[n++] = (s % 4 == 2) ? 46 : 42;             /* hats: open on the off-beat */
+            if (s % 2 == 0) notes[n++] = 51;                 /* ride, 8ths */
+            if (step >= 56 && s % 2 == 1) notes[n++] = s < 12 ? 48 : 43;   /* a tom fill */
+        } else {
+            notes[n++] = 42;
+            if (s == 4 || s == 12) notes[n++] = 38;
+        }
+        uint32_t ages[10];
+        for (i = 0; i < n; i++) {
+            drum_on(notes[i], 100);
+            ages[i] = drums.age;
+            if (notes[i] == 36) {
+                uint32_t v;
+                for (v = 0; v < NDRUM; v++) if (drums.v[v].active && drums.v[v].note == 36 && drums.v[v].age == drums.age) break;
+                k[nk].age = drums.age; k[nk].start = now; k[nk].alive = 1; nk++;
+            }
+        }
+        for (i = 0; i < n && dense; i++) {             /* a hit of this step already gone: never heard */
+            uint32_t v, f = 0;
+            for (v = 0; v < NDRUM; v++) f |= drums.v[v].age == ages[i] && drums.v[v].active;
+            if (!f && notes[i] != 46) { lost++; if (notes[i] == 36) lostk++; }
+        }
+        for (b = 0; b < SB; b++) {
+            block(); now++;
+            { uint32_t v; for (v = 0; v < NDRUM; v++) { if (drums.v[v].age != slot_age[v]) { if (slot_age[v] && dense && (now - slot_t0[v]) * CTL * 1000u / FS < 120u && drums.v[v].note != 0) early++; slot_age[v] = drums.v[v].age; slot_t0[v] = now; if (dense) hits++; } } }
+            for (i = 0; i < nk; i++) {
+                uint32_t v, found = 0, ended = 1;
+                if (!k[i].alive) continue;
+                for (v = 0; v < NDRUM; v++) if (drums.v[v].age == k[i].age) { found = 1; ended = !drums.v[v].active; }
+                if (!found) {      /* its voice went to another hit */
+                    uint32_t self = 0;
+                    for (v = 0; v < NDRUM; v++) if (drums.v[v].active && drums.v[v].note == 36 && drums.v[v].age > k[i].age) self = 1;
+                    if (self) { k[i].alive = 0; continue; }
+                    k[i].alive = 0;
+                    if ((now - k[i].start) * CTL * 1000u / FS < *natural_ms * 9u / 10u) cut++;
+                    k[i].alive = 0;
+                } else if (ended) k[i].alive = 0;
+            }
+        }
+    }
+    *kicks = nk;
+    return cut;
+}
+int main(void)
+{
+    uint32_t kit, kicks, nat, c1, c2, fails = 0;
+    host_tracks_init();
+    printf("NDRUM %u\n", NDRUM);
+    for (kit = 0; kit < DRUM_USR; kit++) {
+        c1 = run_kit(kit, 0, &kicks, &nat);
+        c2 = run_kit(kit, 1, &kicks, &nat);
+        lost = lostk = early = hits = 0;
+        printf("drums: kit %2u (%-8s) kick %4u ms; kicks cut by another sound: simple beat %u/%u, busy beat %u/%u %s\n", kit,
+               kit >= DRUM_SAMPLED ? DS_KITS[kit - DRUM_SAMPLED].name : "GM", nat, c1, kicks, c2, kicks, c1 || c2 ? "FAIL" : "ok");
+        fails += c1 || c2;
+    }
+    printf("drums: %u kits failed\n", fails);
+    return (int)fails;
+}
