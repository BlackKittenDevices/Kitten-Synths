diff --git a/firmware/src/eng_muug.c b/firmware/src/eng_muug.c
index c82f8f3..3961a1b 100644
--- a/firmware/src/eng_muug.c
+++ b/firmware/src/eng_muug.c
@@ -432,9 +432,14 @@ static void fmini_render(track_t *t, voice_t *v, int32_t *out, uint32_t n, const
         fmini_wave(g[FG_W3], &ph2, inc3, l3, mix, n);
     else
         ph2 += inc3 * n;
-    if (ln)
+    if (ln) {                                               /* (2.8.4-kitten: each voice reads the part's noise from its own
+                                                     * place in the block, every other one inverted: voices that sound
+                                                     * together, UNISON's above all, no longer stack the same noise in phase) */
+        uint32_t vi = (uint32_t)(v - t->v) % NVOICE, o = (vi * 13u) % CTL;
+        int32_t lv = (vi & 1u) ? -ln : ln;
         for (i = 0; i < n; i++)
-            mix[i] += mulq15(fmini_nbuf[tr][i], ln);
+            mix[i] += mulq15(fmini_nbuf[tr][(i + o) % CTL], lv);
+    }
 
     /* the singing pitch (MIDI x 16): the CUTOFF knob's dial, the contour, the keyboard, the modulation, the host's (LFO / matrix / ENV routings) */
