+/* a template variation as DRUM_STEP data: {len, div, swing, bpm, kit, dsteps[nstep], micro[nstep]} (steps past len stay empty) */
+function tplBuild(tpl, vi, nstep = 64) {
+  const v = tpl.v[vi] || tpl.v[0];
+  const dsteps = Array.from({ length: nstep }, () => emptyDrum()), micro = new Array(nstep).fill(0);
+  for (const [name, row] of Object.entries(v.lanes)) {
+    const l = TPL_LANE[name];
+    [...row.replace(/\s+/g, "")].forEach((c, i) => {
+      if (c === "." || i >= tpl.len || i >= nstep) return;
+      const [lv, rt] = TPL_HIT[c];
+      dsteps[i].on |= 1 << l;
+      dsteps[i].lvl[l] = lv;
+      dsteps[i].rat[l] = rt;
+    });
+  }
+  for (const [i, m] of Object.entries(v.nudge || {})) if (+i < tpl.len && +i < nstep) micro[+i] = Math.max(MICRO.MIN, Math.min(MICRO.MAX, m));
+  return { len: Math.min(tpl.len, nstep), div: tpl.div, swing: v.swing ?? tpl.swing, bpm: tpl.bpm, kit: v.kit || tpl.kit, dsteps, micro };
+}
