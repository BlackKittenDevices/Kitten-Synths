diff --git a/tests/stems_test.c b/tests/stems_test.c
new file mode 100644
index 0000000..a5606fc
--- /dev/null
+++ b/tests/stems_test.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Kitten Synths: the multitrack USB input's stems (fx.c uac_stem, FELUCCA_UAC_CH 8): each unit's own share of the dry
+ * mix, mono, pre-master.
+ *   alone     one synth part playing: its stem sounds, the other three and the drums' stay exactly 0
+ *   all       four parts and the drums: every stem sounds
+ *   sum       no sends, no TEXTURE, no master effects: twice the stems' sum is the dry mix (L + R) within rounding
+ *   split     the same stems whatever units the second core takes (cpu1_units 0, 15, -1) */
+#define FELUCCA_UAC_CH 8
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+
+static int fails;
+static void check(const char *what, int ok) { printf("%-72s %s\n", what, ok ? "ok" : "FAIL"); fails += !ok; }
+
+static void chords(track_t *t, uint32_t base)
+{
+    uint32_t i;
+    for (i = 0; i < 16u; i++) {
+        uint8_t n[3] = {(uint8_t)(base + i), (uint8_t)(base + i + 4u), (uint8_t)(base + i + 7u)};
+        int on = i % 2u == 0u;
+        put_step(t, i, on ? 3u : 0u, n, on ? ST_NOTE : ST_REST, 0u);
+    }
+}
+static void drum_steps(void)
+{
+    uint32_t i;
+    for (i = 0; i < 16u; i++) {
+        uint8_t n[1] = {(uint8_t)(i % 4u == 0u ? 36 : 42)};
+        put_step(TDRUM, i, 1u, n, ST_NOTE, 0u);
+    }
+}
+
+/* render; energy[k] = sum of |stem k|; err = the largest |L + R - 2 x stems| (sum test: dry mix only) */
+static void render_here(uint32_t parts, int with_drums, int32_t split, uint64_t *energy, int32_t *err, uint64_t *hash)
+{
+    uint32_t b, i, k;
+    cpu1_host_mode();
+    cpu1_units = split;
+    host_tracks_init();
+    song.g[G_DRREV] = song.g[G_DRDLY] = 0;
+    for (k = 0; k < NPART; k++) {
+        host_preset(&trk[k], k == NPART - 1u ? ENGI_LOFI : 0u, k);
+        trk[k].p[P_REV] = trk[k].p[P_DLY] = trk[k].p[P_CHOR] = 0;
+        if (parts & (1u << k))
+            chords(&trk[k], 48u + 5u * k);
+    }
+    if (with_drums)
+        drum_steps();
+    transport_req = 1;
+    memset(energy, 0, sizeof(uint64_t) * (NPART + 1u));
+    *err = 0;
+    *hash = 1469598103934665603ull;
+    for (b = 0; b < 1200u; b++) {
+        int32_t o[2 * CTL];
+        mix_block(o, CTL);
+        for (i = 0; i < CTL; i++) {
+            int32_t s = 0, d;
+            for (k = 0; k <= NPART; k++) {
+                int32_t v = uac_stem[k][i];
+                energy[k] += (uint64_t)(v < 0 ? -v : v);
+                s += v;
+                *hash = (*hash ^ (uint32_t)v) * 1099511628211ull;
+            }
+            d = acc[0].l[i] + acc[0].r[i] - 2 * s;
+            d = d < 0 ? -d : d;
+            if (d > *err)
+                *err = d;
+        }
+    }
+}
+
+/* each render in a fresh child (the DSP state from scratch, as tests/mix_split_test.c does) */
+typedef struct { uint64_t e[NPART + 1u], hash; int32_t err; } res_t;
+static void render(uint32_t parts, int with_drums, int32_t split, uint64_t *energy, int32_t *err, uint64_t *hash)
+{
+    int p[2], st = 0;
+    res_t r;
+    memset(&r, 0, sizeof r);
+    if (pipe(p))
+        exit(2);
+    if (!fork()) {
+        close(p[0]);
+        render_here(parts, with_drums, split, r.e, &r.err, &r.hash);
+        if (write(p[1], &r, sizeof r) != (ssize_t)sizeof r)
+            _exit(3);
+        _exit(0);
+    }
+    close(p[1]);
+    if (read(p[0], &r, sizeof r) != (ssize_t)sizeof r)
+        fails++;
+    close(p[0]);
+    wait(&st);
+    memcpy(energy, r.e, sizeof r.e);
+    *err = r.err;
+    *hash = r.hash;
+}
+
+int main(void)
+{
+    uint64_t e[NPART + 1u], h0, h1;
+    int32_t err;
+    uint32_t k;
+    char what[100];
+    for (k = 0; k < NPART; k++) {
+        uint32_t j;
+        int quiet = 1;
+        render(1u << k, 0, 0, e, &err, &h0);
+        for (j = 0; j <= NPART; j++)
+            if (j != k && e[j])
+                quiet = 0;
+        snprintf(what, sizeof what, "track %u alone: its stem sounds, every other stem is 0", k + 1u);
+        check(what, e[k] > 1000000u && quiet);
+    }
+    render(0xFu, 1, 0, e, &err, &h0);
+    for (k = 0; k <= NPART; k++) {
+        snprintf(what, sizeof what, "all playing: stem %u (%s) sounds", k + 1u, k == NPART ? "drums" : "synth");
+        check(what, e[k] > 1000000u);
+    }
+    snprintf(what, sizeof what, "dry mix = 2 x the stems' sum (largest difference %d)", (int)err);
+    check(what, err <= 2 * (NPART + 1));
+    render(0xFu, 1, 15, e, &err, &h1);
+    check("the same stems with every unit on the second core", h1 == h0);
+    render(0xFu, 1, -1, e, &err, &h1);
+    check("the same stems with the firmware's own split", h1 == h0);
+    printf(fails ? "stems: %d FAILED\n" : "stems: all ok\n", fails);
+    return fails != 0;
+}
