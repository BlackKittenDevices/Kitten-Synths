+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Kitten Synths: the 8-channel USB audio input (usb.c with FELUCCA_UAC_CH 8, fx.c uac_stem):
+ *   descriptors  the input terminal and the type I format say 8 channels, one rate (44.1 kHz), the endpoint's
+ *                packet holds 46 frames of 16 bytes, bcdDevice has its own value (hosts cache per version)
+ *   ring         renders of 32-frame blocks against 1 ms packets: every frame in order, channels 1-2 the master
+ *                (L, R), 3-6 the four synth stems, 7 the drums' stem, 8 silent; a stem past 16 bits is clipped;
+ *                an underrun repeats the whole last frame */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#ifndef HALF_FRAMES
+#define HALF_FRAMES 256
+#endif
+#define RING_PUBLISH() __asm__ volatile("" ::: "memory")
+#define FELUCCA_OTA 0
+#define FELUCCA_CDC 0
+#define FELUCCA_UAC 1
+#define FELUCCA_UAC_CH 8
+#define NPART 4
+#define CTL 32
+static int32_t uac_stem[NPART + 1][CTL];          /* (fx.c's) */
+static void fm1_delay_ms(uint32_t ms) { (void)ms; }
+#pragma GCC diagnostic ignored "-Wint-to-pointer-cast"
+#include "../firmware/src/usb.c"
+
+static int fails;
+static void check(const char *what, int ok)
+{
+    printf("%-70s %s\n", what, ok ? "ok" : "FAIL");
+    fails += !ok;
+}
+
+int main(void)
+{
+    const uint8_t *c, *dv;
+    uint16_t cl, dl;
+    uint32_t off, it_ch = 0, fmt_ch = 0, fmt_rates = 0, maxp = 0, i, k, frame = 0, bad = 0, got = 0;
+    get_desc(0x0100, &dv, &dl);
+    get_desc(0x0200, &c, &cl);
+    for (off = 0; off + 2 <= cl && c[off] >= 2; off += c[off]) {
+        const uint8_t *p = c + off;
+        if (p[1] == 0x24 && p[2] == 2 && p[0] == 12)
+            it_ch = p[7];
+        if (p[1] == 0x24 && p[2] == 2 && p[3] == 1 && p[0] >= 11)
+            fmt_ch = p[4], fmt_rates = p[7];
+        if (p[1] == 5 && p[2] == 0x84)
+            maxp = p[4] | (uint32_t)p[5] << 8;
+    }
+    check("input terminal: 8 channels", it_ch == 8);
+    check("type I format: 8 channels, 16 bit, one rate", fmt_ch == 8 && fmt_rates == 1);
+    check("EP4: 46 frames x 16 bytes (736), under full speed's 1023", maxp == 736 && maxp <= 1023);
+    check("bcdDevice of its own (0x58)", dv[12] == 0x58);
+    check("44.1 kHz only (no resampler)", !FELUCCA_UAC_48K);
+
+    usb.config = 1;
+    memset(&uac, 0, sizeof uac);
+    uac_stream(1);
+    uac.flowing = 1;
+    for (k = 0; k < 400; k++) {                       /* 400 ms: a half of 256 frames every 5.8 ms, a packet a ms */
+        if (frame < (uint32_t)((k + 4) * 44.1)) {
+            int32_t out[2 * CTL];
+            uint32_t b, j;
+            uac_render_start();
+            for (b = 0; b < HALF_FRAMES / CTL; b++) {
+                for (j = 0; j < CTL; j++, frame++) {
+                    uint32_t ch;
+                    out[2 * j] = (int16_t)(frame * 8);
+                    out[2 * j + 1] = (int16_t)(frame * 8 + 1);
+                    for (ch = 0; ch < NPART + 1; ch++)
+                        uac_stem[ch][j] = (int16_t)(frame * 8 + 2 + ch);
+                }
+                if (frame == 4096 + CTL)
+                    uac_stem[1][0] = 100000;        /* (a loud stem: clipped to 32767) */
+                uac_tap(out, CTL);
+            }
+        }
+        {
+            uint32_t d[UA_MAXF * UA_W], n = uac_packet(d);
+            for (i = 0; i < n; i++) {
+                const uint16_t *s = (const uint16_t *)&d[i * UA_W];
+                uint16_t base = s[0];
+                if (!uac.go || (!base && !s[1]))
+                    continue;                       /* (the primed silence) */
+                got++;
+                if (s[1] != (uint16_t)(base + 1) || s[2] != (uint16_t)(base + 2) || s[5] != (uint16_t)(base + 5) ||
+                    s[6] != (uint16_t)(base + 6) || s[7] != 0) {
+                    if (!(s[3] == 32767 && s[2] == (uint16_t)(base + 2)))
+                        bad++;
+                }
+            }
+        }
+    }
+    check("frames arrive with all 8 channels in place (master, 4 synths, drums, silent)", got > 15000 && bad == 0);
+    {
+        uint32_t d[UA_MAXF * UA_W], n, last[UA_W];
+        memcpy(last, uac.last, sizeof last);
+        ua_r = ua_w;                                /* (the ring empty: an underrun) */
+        uac.fill_min = UA_LO;
+        n = uac_packet(d);
+        check("an underrun repeats the whole last frame", n >= 44 && !memcmp(&d[(n - 1) * UA_W], last, sizeof last));
+    }
+    printf(fails ? "uac8: %d FAILED\n" : "uac8: all ok\n", fails);
+    return fails != 0;
+}
