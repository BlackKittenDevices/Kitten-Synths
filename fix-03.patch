diff --git a/tools/kitten_img.py b/tools/kitten_img.py
new file mode 100644
index 0000000..e79b6f6
--- /dev/null
+++ b/tools/kitten_img.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""The Kitten Synths pictures for the web pages (installer, editor, demo), taken from the artwork folder at build time.
+KITTEN_ART = the folder with "kitten open eyes.png" (the workflow sets it to "splashes y logos"). Without it the pages
+get an empty 1x1 picture and the same icons as before: nothing fails."""
+import base64
+import io
+import os
+from pathlib import Path
+
+PLACEHOLDER = "KITTEN_IMG_PLACEHOLDER"
+EMPTY = "data:image/gif;base64,R0lGODlhAQABAAAAACw="
+BOX = (16, 0, 122, 64)              # the cat inside the native 128 x 64 art
+
+
+def art(name="kitten open eyes.png"):
+    d = os.environ.get("KITTEN_ART")
+    p = Path(d) / name if d else None
+    return p if p and p.exists() else None
+
+
+def _native(p):
+    from PIL import Image
+    return Image.open(p).convert("RGB").resize((128, 64), Image.NEAREST)
+
+
+def logo_uri():
+    """the kitten as a small PNG (106 x 64, the pixels as they are) in a data URI"""
+    p = art()
+    if not p:
+        return EMPTY
+    b = io.BytesIO()
+    _native(p).crop(BOX).quantize(32).save(b, "PNG", optimize=True)
+    return "data:image/png;base64," + base64.b64encode(b.getvalue()).decode()
+
+
+def brand(html):
+    return html.replace(PLACEHOLDER, logo_uri())
+
+
+def icons(out_dir):
+    """icon-192.png, icon-512.png, icon-maskable-512.png from the kitten (black square), when the art is there"""
+    p = art()
+    if not p:
+        return False
+    from PIL import Image
+    cat = _native(p).crop(BOX)
+    for name, size, pad in (("icon-192.png", 192, 0.08), ("icon-512.png", 512, 0.08), ("icon-maskable-512.png", 512, 0.22)):
+        sq = Image.new("RGB", (size, size), (0, 0, 0))
+        w = int(size * (1 - 2 * pad))
+        h = int(w * cat.height / cat.width)
+        sq.paste(cat.resize((w, h), Image.NEAREST), ((size - w) // 2, (size - h) // 2))
+        sq.save(Path(out_dir) / name, "PNG")
+    return True
