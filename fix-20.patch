diff --git a/tests/drum2_test.c b/tests/drum2_test.c
new file mode 100644
index 0000000..05db2a5
--- /dev/null
+++ b/tests/drum2_test.c
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Kitten Synths 2.8-kitten: the second drum track (TRK_DRUM2: its own kit, pattern, level, pan, mute, MIDI channel 11, the
+ * USB input's channel 8).
+ *   alone      the second drum track's pattern: its stem sounds, the first drum track's stays exactly 0, and the reverse
+ *   apart      both together, different kits: the first drum track's stem bit for bit as when it plays alone
+ *   level      its own LEVEL (P_LEVEL), not GLO > DRUMS: lower, quieter; MUTE: silent
+ *   MIDI       a note on channel 11 plays the second drum track; on 10 the first, as in SLOOP
+ *   split      the same stems whatever units the second core takes */
+#define FELUCCA_UAC_CH 8
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+
+static int fails;
+static void check(const char *what, int ok) { printf("%-100s %s\n", what, ok ? "ok" : "FAIL"); fails += !ok; }
+
+static void beat(track_t *t, int busy)
+{
+    uint32_t i;
+    for (i = 0; i < 16u; i++) {
+        uint8_t n[1] = {(uint8_t)(i % 4u == 0u ? 36 : busy ? (i % 4u == 2u ? 38 : 42) : 42)};
+        put_step(t, i, 1u, n, ST_NOTE, 0u);
+    }
+}
+
+typedef struct { uint64_t e1, e2, h1, h2, mix; } res_t;
+/* d: bit 0 the first drum track's beat, bit 1 the second's; midi: 0, or a channel (1..16) each beat's kick comes in on */
+static res_t render(uint32_t d, int32_t split, int16_t lvl2, int mute2, uint32_t midi)
+{
+    res_t r;
+    uint32_t b, i;
+    memset(&r, 0, sizeof r);
+    r.h1 = r.h2 = 1469598103934665603ull;
+    cpu1_host_mode();
+    cpu1_units = split;
+    rng_state = 0x1234567u;                            /* (the noise of the hats: the same draws each render) */
+    host_tracks_init();
+    memset(drum_sts, 0, sizeof drum_sts);
+    drum_sts[0].set = drum_sts[1].set = -2;
+    song.g[G_DRREV] = song.g[G_DRDLY] = 0;
+    song.g[G_DRCH] = 10;
+    TDRUM->p[P_E0] = DRUM_DEFAULT_KIT;                 /* the 808 */
+    TDRUM2->p[P_E0] = 0;                               /* ACOUSTIC */
+    TDRUM2->p[P_REV] = TDRUM2->p[P_DLY] = 0;
+    TDRUM2->p[P_LEVEL] = lvl2;
+    TDRUM2->p[P_MUTE] = (int16_t)mute2;
+    if (d & 1u)
+        beat(TDRUM, 0);
+    if (d & 2u)
+        beat(TDRUM2, 1);
+    if (!midi)
+        transport_req = 1;
+    for (b = 0; b < 1200u; b++) {
+        int32_t o[2 * CTL];
+        if (midi && b % 100u == 10u)
+            midi_in_event(0x09u | (0x90u | (midi - 1u)) << 8 | 36u << 16 | 110u << 24);
+        mix_block(o, CTL);
+        for (i = 0; i < CTL; i++) {
+            int32_t v1 = uac_stem[NPART][i], v2 = uac_stem[NPART + 1u][i];
+            r.e1 += (uint64_t)(v1 < 0 ? -v1 : v1);
+            r.e2 += (uint64_t)(v2 < 0 ? -v2 : v2);
+            r.h1 = (r.h1 ^ (uint32_t)v1) * 1099511628211ull;
+            r.h2 = (r.h2 ^ (uint32_t)v2) * 1099511628211ull;
+            r.mix += (uint64_t)(o[2u * i] < 0 ? -o[2u * i] : o[2u * i]);
+        }
+    }
+    return r;
+}
+
+int main(void)
+{
+    res_t a1, a2, both, lo, mu, m10, m11, sp;
+    check("the second drum track: track 6 (after the drum track), a drum track, channel 11, USB channel 8",
+          TRK_DRUM2 == 5u && NTRK == 6u && is_drum(TDRUM2) && is_drum(TDRUM) && !is_drum(&trk[NHEAVY]) && trk_midi_ch(TRK_DRUM2) == 10u);
+    a1 = render(1u, 0, 104, 0, 0);
+    a2 = render(2u, 0, 104, 0, 0);
+    check("alone: the first drum track's beat sounds on its stem (7), the second's stem silent", a1.e1 > 1000000u && a1.e2 == 0u);
+    check("alone: the second drum track's beat sounds on its stem (8), the first's stem silent", a2.e2 > 1000000u && a2.e1 == 0u);
+    both = render(3u, 0, 104, 0, 0);
+    printf("  stems alone / together: first %llu / %llu, second %llu / %llu\n", (unsigned long long)a1.e1, (unsigned long long)both.e1,
+           (unsigned long long)a2.e2, (unsigned long long)both.e2);
+    check("apart: both together, each drum track's stem as when it plays alone (within 3 %: the hats' noise draws interleave)",
+          both.e1 * 100u > a1.e1 * 97u && both.e1 * 100u < a1.e1 * 103u && both.e2 * 100u > a2.e2 * 97u &&
+          both.e2 * 100u < a2.e2 * 103u);
+    lo = render(2u, 0, 60, 0, 0);
+    mu = render(2u, 0, 104, 1, 0);
+    printf("  second drum track's stem: LEVEL 104 %llu, LEVEL 60 %llu, MUTE %llu\n", (unsigned long long)a2.e2,
+           (unsigned long long)lo.e2, (unsigned long long)mu.e2);
+    check("level: its own LEVEL (60 under 104: quieter); MUTE: silent", lo.e2 > 0u && lo.e2 * 10u < a2.e2 * 7u && mu.e2 == 0u);
+    m10 = render(0u, 0, 104, 0, 10);
+    m11 = render(0u, 0, 104, 0, 11);
+    check("MIDI: a kick on channel 10 plays the first drum track (as SLOOP), on 11 the second", m10.e1 > 100000u && m10.e2 == 0u &&
+          m11.e2 > 100000u && m11.e1 == 0u);
+    both = render(3u, 0, 104, 0, 0);
+    sp = render(3u, -1, 104, 0, 0);
+    check("split: the second core taking the drums unit (the default): the same stems", sp.h1 == both.h1 && sp.h2 == both.h2);
+    sp = render(3u, 15, 104, 0, 0);
+    check("split: the drums on core 0: the same stems", sp.h1 == both.h1 && sp.h2 == both.h2);
+    printf(fails ? "drum2: %d FAILED\n" : "drum2: 0 failed\n", fails);
+    return fails != 0;
+}
