+/* --------------------------------------------------------- the patch on the panel --- */
+/* The patch's 18 bytes (and its switch bits) as pages of four knobs: params.c PAGES with scope SC_MUUG, shown while the selected
+ * track plays MUUG (EDIT: the oscillator bank and the mixer; LFO: the modifiers). A value is read from the part's patch each
+ * frame and written back through muug_put (the SLOT becomes OWN, as the editor's). */
+static const char *const MG_RANGE[] = {"LO", "32'", "16'", "8'", "4'", "2'"};
+static const char *const MG_WAVE[] = {"TRI", "SHARK", "SAW", "SQR", "PLS W", "PLS N"};
+static const char *const MG_ON[] = {"OFF", "1", "2", "1 2", "3", "1 3", "2 3", "ALL"};
+static const char *const MG_NZ[] = {"OFF", "WHITE", "PINK"};
+typedef struct {
+    param_desc_t d;
+    uint8_t idx, shift, mask;      /* the byte of the patch, the bits of it */
+    uint8_t bias, noise;           /* shown = raw - bias; 1: the NOISE / PINK pair as OFF, WHITE, PINK */
+} mg_t;
+#define MG_E(l, n, nm, i, sh, mk) {{l, F_ENUM, 0, n, 0, nm, 0}, i, sh, mk, 0, 0}
+#define MG_P(l, i) {{l, F_PCT, 0, 127, 0, 0, 0}, i, 0, 127, 0, 0}
+#define MG_B(l, i) {{l, F_BIPCT, -64, 63, 0, 0, 0}, i, 0, 127, 64, 0}
+#define MG_S(l, i, sh) {{l, F_ONOFF, 0, 1, 0, 0, 0}, i, sh, 1, 0, 0}
+static const mg_t MG[] = {
+    MG_E("RNG 1", 5, MG_RANGE, FG_R1, 0, 127), MG_E("RNG 2", 5, MG_RANGE, FG_R2, 0, 127), MG_E("RNG 3", 5, MG_RANGE, FG_R3, 0, 127),
+    MG_E("OSC ON", 7, MG_ON, FG_SW1, 0, 7),                                                                         /* 3 */
+    MG_E("WAVE 1", 5, MG_WAVE, FG_W1, 0, 127), MG_E("WAVE 2", 5, MG_WAVE, FG_W2, 0, 127), MG_E("WAVE 3", 5, MG_WAVE, FG_W3, 0, 127),
+    MG_B("TUNE", FG_TUNE),                                                                                          /* 7 */
+    MG_B("FREQ 2", FG_F2), MG_B("FREQ 3", FG_F3), MG_P("KBD", FG_KBD),
+    {{"NOISE", F_ENUM, 0, 2, 0, MG_NZ, 0}, FG_SW1, 3, 3, 0, 1},                                                      /* 11 */
+    MG_P("OSC 1", FG_L1), MG_P("OSC 2", FG_L2), MG_P("OSC 3", FG_L3), MG_P("NOISE", FG_LN),                          /* 12..15 */
+    MG_P("SRC", FG_MMIX), MG_S(">OSC", FG_SW1, 5), MG_S(">FILT", FG_SW1, 6), MG_S("SQR", FG_SW2, 1),         /* 16..19 */
+};
+static int16_t mg_get(uint32_t tr, uint32_t id)
+{
+    const mg_t *m = &MG[id];
+    uint32_t v = ((uint32_t)fmini_patch[tr % NTRK][m->idx] >> m->shift) & m->mask;
+    if (m->noise)
+        v = v & 1u ? (v & 2u ? 2u : 1u) : 0u;
+    return (int16_t)((int32_t)v - m->bias);
+}
+static void mg_set(uint32_t tr, uint32_t id, int32_t val)
+{
+    const mg_t *m = &MG[id];
+    uint8_t p[FG_SIZE];
+    uint32_t v = (uint32_t)(val + m->bias);
+    tr %= NTRK;
+    memcpy(p, fmini_patch[tr], FG_SIZE);
+    if (m->noise)
+        v = v == 2u ? 3u : v;
+    p[m->idx] = (uint8_t)((p[m->idx] & ~(m->mask << m->shift)) | ((v & m->mask) << m->shift));
+    if (memcmp(p, fmini_patch[tr], FG_SIZE))
+        muug_put(tr, p);
+}
+
