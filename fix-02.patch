+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Kitten Synths art: draws an RLE image of kitten_art.h (tools/gen_kitten.py) at 2x into the canvas (cv_rect clips to the
+ * band: cv_oy). Runs are (run - 1) << 3 | colour, never across a row; colour 0 is the black background, not drawn. */
+#pragma once
+#include "kitten_art.h"
+static void kitten_draw(const uint8_t *d, uint32_t n, int32_t x0, int32_t y0)
+{
+    uint32_t i, x = 0, y = 0;
+    for (i = 0; i < n; i++) {
+        uint32_t run = (uint32_t)(d[i] >> 3) + 1u, c = d[i] & 7u;
+        int32_t py = y0 + (int32_t)y * 2;
+        if (c && py + 2 > -cv_oy && py < (int32_t)cv_h - cv_oy)
+            cv_rect(x0 + (int32_t)x * 2, py, (int32_t)run * 2, 2, KITTEN_PAL[c]);
+        x += run;
+        if (x >= KITTEN_W) {
+            x = 0;
+            y++;
+        }
+    }
+}
