diff --git a/tools/gen_kitten.py b/tools/gen_kitten.py
new file mode 100644
index 0000000..0bfbf25
--- /dev/null
+++ b/tools/gen_kitten.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Kitten Synths art: the boot splash and the two animated kitten frames (eyes open / closed).
+  tools/gen_kitten.py "DIR with the three PNGs" OUT.h
+The source art is 128x64 pixels blown up 8x; it is cropped to the cat, cut to 8 colours (one shared palette, black = 0)
+and stored as RLE bytes: (run - 1) << 3 | colour, a run never crosses a row. The firmware draws it at 2x."""
+import sys
+from pathlib import Path
+import numpy as np
+from PIL import Image
+
+NAMES = ["kitten splash.png", "kitten open eyes.png", "kitten close eyes.png"]
+BOX = (16, 0, 122, 64)            # 106 x 64 of the native 128 x 64
+DARK = 60                          # r+g+b below this is black (long black runs)
+
+def main(src, out):
+    arrs = []
+    for n in NAMES:
+        im = Image.open(Path(src) / n).convert("RGB").resize((128, 64), Image.NEAREST).crop(BOX)
+        a = np.array(im).astype(int)
+        a[a.sum(2) < DARK] = 0
+        arrs.append(a.astype(np.uint8))
+    h = arrs[0].shape[0]; w = arrs[0].shape[1]
+    q = Image.fromarray(np.vstack(arrs)).quantize(8, method=Image.MEDIANCUT, dither=Image.NONE)
+    pal = np.array(q.getpalette()[:24]).reshape(8, 3)
+    idx = np.array(q)
+    order = list(np.argsort(pal.sum(1)))             # black first
+    remap = {int(o): i for i, o in enumerate(order)}
+    pal = pal[order]
+    pal[0] = (0, 0, 0)
+    rgb565 = lambda c: ((int(c[0]) >> 3) << 11) | ((int(c[1]) >> 2) << 5) | (int(c[2]) >> 3)
+    lines = ["/* generated by tools/gen_kitten.py: the Kitten Synths splash and the two kitten frames */", "#pragma once",
+             "#include <stdint.h>", f"#define KITTEN_W {w}u", f"#define KITTEN_H {h}u",
+             "static const uint16_t KITTEN_PAL[8] = {" + ", ".join(f"0x{rgb565(c):04X}" for c in pal) + "};"]
+    total = 0
+    for i, name in enumerate(["SPLASH", "OPEN", "CLOSE"]):
+        rows = idx[h * i:h * (i + 1)]
+        rle = []
+        for r in rows:
+            r = [remap[int(v)] for v in r]
+            x = 0
+            while x < len(r):
+                j = x
+                while j < len(r) and r[j] == r[x] and j - x < 32:
+                    j += 1
+                rle.append(((j - x - 1) << 3) | r[x])
+                x = j
+        total += len(rle)
+        lines.append(f"static const uint8_t KITTEN_{name}[{len(rle)}] = {{")
+        for k in range(0, len(rle), 24):
+            lines.append("    " + ", ".join(str(v) for v in rle[k:k + 24]) + ",")
+        lines.append("};")
+    Path(out).write_text("\n".join(lines) + "\n")
+    print(f"kitten art: {w}x{h}, 3 images, {total} B of RLE -> {out}")
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
