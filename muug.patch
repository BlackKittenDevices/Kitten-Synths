+#define NTRK 5                   /* + the drum track */
+#define TRK_DRUM 4
+/* Two numberings outside the working one (tracks 1..3, the LITE part, the drum track last):
+ *  - the EDITOR's (protocol): the working one, as INFO says (ntrk): the drum track is the last, whatever the count (trk_wire);
+ *  - SLOOP's own four (a project file's records, the 4 pads / columns / meters of the screen): tracks 1..3, then the drum track
