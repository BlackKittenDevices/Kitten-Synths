+    /* oscillator pitches */
+    p16 = m->pitch16 + (sw & FS_MOSC ? (mod * 16) >> 14 : 0);    /* full depth: +-2 semitones */
+    fine = m->fine + ((int32_t)g[FG_TUNE] - 64) * 237 / 64;
