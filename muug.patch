+static inline uint32_t trk_wire(uint32_t k) { return k < NTRK ? k : TRK_NOWIRE; }
+static inline uint32_t trk_of_wire(uint32_t w) { return w < NTRK ? w : TRK_NOWIRE; }
+#define TRK_UI_N 4u
+static inline uint32_t trk_ui(uint32_t k) { return k < NHEAVY ? k : k == TRK_DRUM ? NHEAVY : TRK_NOWIRE; }
+static inline uint32_t trk_of_ui(uint32_t w) { return w < NHEAVY ? w : w == NHEAVY ? TRK_DRUM : TRK_NOWIRE; }
