+
+python3 tools/build_demo.py        ->  build/demo/   (index.html, preview.js, preview-worklet.js, sloop-preview.wasm, ...)
+python3 build/demo/servir.py       ->  http://localhost:8000/index.html?mock=1
+
+Needs clang and lld (wasm-ld) or Emscripten, as tools/build_preview.py. Nothing here touches an FM-1.
+"""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / 'build/demo'
+SERVER = '''# Serves this folder at http://localhost:8000 and opens the SLOOP demo (mock mode, no FM-1).
+import http.server, socketserver, webbrowser, os
+os.chdir(os.path.dirname(os.path.abspath(__file__)))
+http.server.SimpleHTTPRequestHandler.extensions_map.update({".wasm": "application/wasm", ".js": "text/javascript"})
+socketserver.TCPServer.allow_reuse_address = True
+with socketserver.TCPServer(("127.0.0.1", 8000), http.server.SimpleHTTPRequestHandler) as s:
+    webbrowser.open("http://localhost:8000/index.html?mock=1")
+    print("Demo at http://localhost:8000/index.html?mock=1  (Ctrl+C to stop)")
+    s.serve_forever()
+'''
+
+
+def main():
+    subprocess.run([sys.executable, str(ROOT / 'tools/build_preview.py')], cwd=ROOT, check=True)
+    if OUT.exists():
+        shutil.rmtree(OUT)
+    OUT.mkdir(parents=True)
+    shutil.copy(ROOT / 'web/editor.html', OUT / 'index.html')
+    for name in ['preview.js', 'preview-worklet.js', 'sloop-preview.wasm']:
+        shutil.copy(ROOT / 'build/preview' / name, OUT / name)
+    for name in ['fukiai.ttf', 'FUKIAI-LICENSE.txt']:
+        shutil.copy(ROOT / 'web' / name, OUT / name)
+    (OUT / 'servir.py').write_text(SERVER, encoding='utf-8')
+    print('Demo built:', OUT)
+
+
+if __name__ == '__main__':
+    main()
