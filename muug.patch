diff --git a/tests/muug_test.c b/tests/muug_test.c
new file mode 100644
index 0000000..c4ff0ef
--- /dev/null
+++ b/tests/muug_test.c
@@ -0,0 +1,199 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * MUUG engine test (firmware/src/eng_muug.c, editor_muug.c) on the host, through hostsim.c as fm6_test.c.
+ *   build/host/muug_test
+ * 1. muug_put: every byte into its range, SLOT becomes OWN, the patch is what the part plays (what MUUG_GET returns).
+ * 2. the protocol handlers (editor_muug.c): MUUG_GET returns the part's FG_SIZE bytes, MUUG_PUT sets them (and clamps
+ *    them), a bad track or length is rc 1, the drum track has none.
+ * 3. the panel's controls do what they say: a wave (SQR is brighter than TRI), a range (2' is higher than 16'), the
+ *    oscillator switches (all off with the noise off is silence; the noise alone is not), a level (OSC 1 louder).
+ * 4. the mod wheel: with MOD 0 and the LFO on the oscillators, CC1 at 0 is bit-identical to no modulation, CC1 at 127
+ *    changes the sound; and a sound that loads puts the wheel back at rest.
+ * 5. a factory SLOT after an own patch loads the factory patch, and back to OWN brings the own one again. */
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+static struct { int force; } ui;                       /* (ui.c's: editor_muug.c sets it) */
+static uint8_t ed_buf[64];
+static uint32_t ed_len;
+static void ed_b(uint32_t v) { if (ed_len < sizeof ed_buf) ed_buf[ed_len++] = (uint8_t)(v & 127u); }
+#include "../firmware/src/editor_muug.c"
+
+static int bad;
+static void check(const char *what, int ok)
+{
+    printf("muug: %-92s %s\n", what, ok ? "ok" : "FAIL");
+    bad += !ok;
+}
+
+/* track 0 = MUUG on slot s, nothing else (no FX), POLY */
+static void setup(uint32_t slot)
+{
+    memset(trk, 0, sizeof trk);
+    memset(eng_arena, 0, sizeof eng_arena);
+    memset(eng_arena_own, 0, sizeof eng_arena_own);
+    memset(fmini_eff, 0, sizeof fmini_eff);
+    memset((void *)fmini_mw, 0, sizeof fmini_mw);
+    fmini_own_ok = 0;
+    {   /* the part's noise and smoothers at power-on (the VCOs' random walk draws from them: a repeatable render) */
+        static const int32_t nst[NTRK] = {0x2F6E2B1, 0x1A2B3C5, 0x3C4D5E7, 0x0F1E2D3};
+        memcpy(fmini_nst, nst, sizeof fmini_nst);
+        memset(fmini_pk, 0, sizeof fmini_pk);
+        memset(fmini_sm, 0, sizeof fmini_sm);
+        fmini_sm_ok = 0;
+    }
+    host_tracks_init();
+    host_preset(&trk[0], ENGI_MUUG, slot);
+    trk[0].p[P_VOICE] = V_POLY;
+    trk[0].p[P_CHOR] = trk[0].p[P_DLY] = trk[0].p[P_REV] = 0;
+    fmini_track_loaded(&trk[0]);
+}
+static void patch_set(const uint8_t *v)
+{
+    ed_len = 0;
+    uint8_t a[1 + FG_SIZE];
+    a[0] = 0;
+    memcpy(a + 1, v, FG_SIZE);
+    ed_muug_handle(ED_MUUG_PUT, a, 1u + FG_SIZE);
+}
+static void render(uint32_t note, double *y, uint32_t n)
+{
+    static int32_t b[CTL];
+    uint32_t i, k;
+    trk_note_on(&trk[0], note, 100);
+    for (i = 0; i < n; i += CTL) {
+        track_render(&trk[0], b, CTL);
+        for (k = 0; k < CTL && i + k < n; k++)
+            y[i + k] = b[k];
+    }
+    trk_note_off(&trk[0], note);
+    for (i = 0; i < 4000; i += CTL)
+        track_render(&trk[0], b, CTL);
+}
+static double rms(const double *y, uint32_t a, uint32_t b)
+{
+    double s = 0;
+    uint32_t i;
+    for (i = a; i < b; i++)
+        s += y[i] * y[i];
+    return sqrt(s / (b - a));
+}
+static double zcr(const double *y, uint32_t a, uint32_t b)       /* crossings per sample: a brightness / pitch proxy */
+{
+    uint32_t i, z = 0;
+    for (i = a + 1; i < b; i++)
+        z += (y[i] > 0) != (y[i - 1] > 0);
+    return (double)z / (b - a);
+}
+#define N 12000
+static double ya[N], yb[N];
+static uint8_t base_patch(void)                                  /* OSC 1 only: 8', SAW, full level; filter wide open */
+{
+    return 0;
+}
+
+int main(void)
+{
+    uint8_t v[FG_SIZE], w[FG_SIZE];
+    uint32_t i;
+    int same;
+    setup(0);
+    (void)base_patch;
+    for (i = 0; i < FG_SIZE; i++)
+        v[i] = 127;                                                  /* out of range everywhere */
+    patch_set(v);
+    same = 1;
+    for (i = 0; i < FG_SIZE; i++)
+        same &= fmini_patch[0][i] == (i < FG_NUM ? fmini_max(i) : 0u);
+    check("1. muug_put: every byte clamped to its range, the bytes past FG_NUM zero", same);
+    check("1. muug_put: SLOT becomes OWN (the part's own patch now)", trk[0].p[P_E7] == (int16_t)FMINI_OWN && fmini_slot[0] == FMINI_OWN);
+    check("2. MUUG_PUT answers track, rc 0", ed_len == 2 && ed_buf[0] == 0 && ed_buf[1] == 0);
+    ed_len = 0;
+    {
+        uint8_t a = 0;
+        ed_muug_handle(ED_MUUG_GET, &a, 1);
+    }
+    same = ed_len == 2u + FG_SIZE && ed_buf[1] == 0;
+    for (i = 0; i < FG_SIZE && same; i++)
+        same &= ed_buf[2 + i] == fmini_patch[0][i];
+    check("2. MUUG_GET returns the part's FG_SIZE bytes (what it plays)", same);
+    ed_len = 0;
+    {
+        uint8_t a = NPART;                                           /* the drum track: none */
+        ed_muug_handle(ED_MUUG_GET, &a, 1);
+    }
+    check("2. MUUG_GET on the drum track: rc 1, no bytes", ed_len == 2 && ed_buf[1] == 1);
+    ed_len = 0;
+    {
+        uint8_t a[2] = {0, 5};                                       /* a short PUT */
+        ed_muug_handle(ED_MUUG_PUT, a, 2);
+    }
+    check("2. MUUG_PUT with the wrong length: rc 1", ed_len == 2 && ed_buf[1] == 1);
+
+    /* 3. the controls */
+    memcpy(v, FMINI_FACTORY[0], FG_SIZE);
+    memset(v + FG_R1, 3, 3); memset(v + FG_W1, 2, 3);                /* 8', SAW */
+    v[FG_L1] = 127; v[FG_L2] = v[FG_L3] = v[FG_LN] = 0;
+    v[FG_SW1] = FS_O1; v[FG_SW2] = 0; v[FG_F2] = v[FG_F3] = 64; v[FG_TUNE] = 64;
+    setup(0); trk[0].p[P_E0] = 127; trk[0].p[P_E1] = 0;               /* CUT open, no emphasis */
+    memcpy(w, v, FG_SIZE);
+    w[FG_W1] = 0;                                                     /* TRI */
+    patch_set(w); render(48, ya, N);
+    memcpy(w, v, FG_SIZE); w[FG_W1] = 3;                              /* SQR */
+    patch_set(w); render(48, yb, N);
+    check("3. wave: SQR is brighter than TRI", zcr(yb, 2000, N) > 0 && zcr(yb, 2000, N) >= zcr(ya, 2000, N) && rms(yb, 2000, N) > 0 && rms(ya, 2000, N) > 0);
+    memcpy(w, v, FG_SIZE); w[FG_R1] = 2;                              /* 16' */
+    patch_set(w); render(48, ya, N);
+    memcpy(w, v, FG_SIZE); w[FG_R1] = 5;                              /* 2' */
+    patch_set(w); render(48, yb, N);
+    check("3. range: 2' sounds higher than 16' (more zero crossings)", zcr(yb, 2000, N) > 2.0 * zcr(ya, 2000, N));
+    memcpy(w, v, FG_SIZE); w[FG_SW1] = 0;                             /* every oscillator off, no noise */
+    patch_set(w); render(48, ya, N);
+    check("3. switches: all oscillators off and no noise is silence", rms(ya, 2000, N) < 1.0);
+    memcpy(w, v, FG_SIZE); w[FG_SW1] = FS_NZ; w[FG_LN] = 127;         /* the noise alone */
+    patch_set(w); render(48, ya, N);
+    check("3. switches: the noise alone sounds", rms(ya, 2000, N) > 50.0);
+    memcpy(w, v, FG_SIZE); w[FG_L1] = 60;
+    patch_set(w); render(48, ya, N);
+    patch_set(v); render(48, yb, N);
+    check("3. mixer: OSC 1 level 127 is louder than 60", rms(yb, 2000, N) > rms(ya, 2000, N));
+
+    /* 4. the mod wheel: the LFO on the oscillators, MOD 0 (each render from a fresh track: the LFO runs free) */
+    {
+        double d;
+        uint32_t k;
+        static double r_off[N], r_mod0[N], r_mod127[N];
+        const uint8_t sws[3] = {FS_O1, FS_O1 | FS_MOSC, FS_O1 | FS_MOSC};
+        const uint8_t wheel[3] = {0, 0, 127};
+        double *out[3] = {r_off, r_mod0, r_mod127};
+        for (i = 0; i < 3; i++) {
+            setup(0);
+            trk[0].p[P_E0] = 127; trk[0].p[P_E1] = 0; trk[0].p[P_E6] = 0; trk[0].p[P_LRATE] = 90;
+            memcpy(w, v, FG_SIZE); w[FG_SW1] = sws[i]; w[FG_MMIX] = 0;
+            patch_set(w);
+            trk[0].p[P_E6] = 0;
+            fmini_mw[0] = wheel[i];
+            render(48, out[i], N);
+        }
+        for (d = 0, k = 0; k < N; k++)
+            d += fabs(r_off[k] - r_mod0[k]);
+        check("4. mod wheel at 0, MOD 0: the LFO switch changes nothing (bit-identical)", d == 0.0);
+        for (d = 0, k = 2000; k < N; k++)
+            d += fabs(r_off[k] - r_mod127[k]);
+        check("4. mod wheel at 127: the LFO reaches the oscillators (the sound changes)", d > 1000.0);
+    }
+    fmini_mw[0] = 99;
+    fmini_track_loaded(&trk[0]);
+    check("4. a sound that loads puts the wheel back at rest", fmini_mw[0] == 0);
+
+    /* 5. own -> factory -> own */
+    setup(0);
+    patch_set(v);                                                     /* own */
+    trk[0].p[P_E7] = 7; fmini_poll();
+    same = memcmp(fmini_patch[0], FMINI_FACTORY[7], FG_SIZE) == 0 && fmini_slot[0] == 7;
+    check("5. SLOT 8 after an own patch loads factory patch 8", same);
+    trk[0].p[P_E7] = (int16_t)FMINI_OWN; fmini_poll();
+    check("5. back to OWN brings the own patch again", memcmp(fmini_patch[0], v, FG_SIZE) == 0 && fmini_slot[0] == FMINI_OWN);
+
+    printf("muug: %s\n", bad ? "FAILED" : "all ok");
+    return bad ? 1 : 0;
+}
