+    uint32_t tr = (uint32_t)(t - trk) % NTRK, i, sw = g[FG_SW1];
+    uint32_t inc1, inc2, inc3;
+    int32_t s0 = v->s[0], s1 = v->s[1], s2 = v->s[2], s3 = v->s[3], sx = v->s[4];
+    uint32_t ph0 = v->ph[0], ph1 = v->ph[1], ph2 = v->ph[2];
+    if (n > CTL)
