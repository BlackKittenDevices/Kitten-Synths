diff --git a/firmware/src/dsp.c b/firmware/src/dsp.c
index 9042a9b..56c2afd 100644
--- a/firmware/src/dsp.c
+++ b/firmware/src/dsp.c
@@ -116,3 +116,12 @@ static inline int32_t amp_at(const vmod_t *m, uint32_t i)
     int32_t x = (m->amp1 - m->amp0) * (int32_t)i;
     return m->amp0 + ((x + ((x >> 31) & (CTL - 1))) >> CTL_LOG2);
 }
+
+/* phase increment of pitch16 (1/16 semitone) plus ct cents: whole 1/16 semitones from the table, the rest (and fine,
+ * in 1/4096) as a factor (1 ct = 2.367 / 4096). From Felucca-Engines dsp.c (MIT), used by MUUG */
+static inline uint32_t cents_inc(int32_t pitch16, int32_t ct, int32_t fine)
+{
+    int32_t d16 = ct * 16 / 100, rem = ct * 16 - d16 * 100;          /* rem: 1/1600 semitone */
+    uint32_t inc = pitch_inc(clamp(pitch16 + d16, 0, 2047));
+    return inc + (uint32_t)((int32_t)(inc >> 12) * (rem * 2367 / 16000 + fine));
+}
