diff --git a/tests/lite_part_test.c b/tests/lite_part_test.c
new file mode 100644
index 0000000..2466255
--- /dev/null
+++ b/tests/lite_part_test.c
@@ -0,0 +1,188 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * The LITE part (the 4th synth part, track 4 on the device) on the host, through hostsim.c as fm6_test.c.
+ *   build/host/lite_part_test
+ * 1. the engines it plays (DIGITAL, PHASE, LOFI, SAMPLE, VOICE): eng_allowed / eng_fit; the heavy parts play every one; it has no
+ *    engine-state arena (the engines that need one are not its).
+ * 2. every allowed engine sounds on it, bounded.
+ * 3. it never moves the other parts' sound: part 1 (PHYS, S&H LFO) renders the same bit for bit whether the LITE part's LFO wraps
+ *    seldom or all the time (its draws come from rng2, not from the generator the heavy parts share).
+ * 4. MIDI as SLOOP's: the synth parts' channels 1..3 and the drum channel as set; the LITE part has none (OFF), and no channel
+ *    is its own.
+ * 5. the numbers outside the firmware (a project file, the editor's protocol) are SLOOP's four; the LITE part has none there.
+ * 6. a project saves the four records of SLOOP (the same size as before) and loads them: the heavy parts and the drum track come
+ *    back, the LITE part has its power-on sound, the selected drum track is the drum track. */
+#define main hostsim_main
+#include <stddef.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "hostsim.c"
+#undef main
+#define PROJ_HOST 1
+static uint32_t trk_def_engine(uint32_t i)       /* ui.c TRK_DEF: ANALOG, DIGITAL, LOFI (the heavy parts' records) */
+{
+    static const uint8_t E[NHEAVY] = {0, 1, 3};
+    return i < NHEAVY ? E[i] : 0u;
+}
+#include "../firmware/src/project.c"
+
+static int bad;
+static void check(const char *what, int ok)
+{
+    printf("lite: %-100s %s\n", what, ok ? "ok" : "FAIL");
+    bad += !ok;
+}
+static double rms(const double *y, uint32_t a, uint32_t b)
+{
+    double s = 0;
+    uint32_t i;
+    for (i = a; i < b; i++)
+        s += y[i] * y[i];
+    return sqrt(s / (b - a));
+}
+#define N 12000
+static double ya[N], yb[N];
+static void render_part(uint32_t k, uint32_t note, double *y, uint32_t n)
+{
+    static int32_t b[CTL];
+    uint32_t i, j;
+    trk_note_on(&trk[k], note, 100);
+    for (i = 0; i < n; i += CTL) {
+        track_render(&trk[k], b, CTL);
+        for (j = 0; j < CTL && i + j < n; j++)
+            y[i + j] = b[j];
+    }
+    trk_note_off(&trk[k], note);
+}
+
+int main(void)
+{
+    static const char *const NAMES[] = {"DIGITAL", "PHASE", "LOFI", "SAMPLE", "VOICE"};
+    uint32_t e, k, i;
+    int ok;
+
+    /* 1. engines */
+    ok = 1;
+    for (e = 0; e < NENGINES; e++) {
+        int lite = e >= 1u && e <= 5u;
+        ok &= eng_allowed(NHEAVY, e) == lite;
+        for (k = 0; k < NHEAVY; k++)
+            ok &= eng_allowed(k, e) == 1;
+    }
+    check("1. the LITE part plays engines 1..5 only; the heavy parts play all of them", ok);
+    ok = 1;
+    for (i = 0; i < 5u; i++)
+        ok &= !strcmp(ENGINES[1u + i]->name, NAMES[i]);
+    check("1. those are DIGITAL, PHASE, LOFI, SAMPLE and VOICE (ENGINES[] order)", ok);
+    check("1. eng_fit: what it cannot play becomes SAMPLE; what it can stays; the heavy parts keep everything",
+          eng_fit(NHEAVY, ENGI_FM6) == ENGI_SAMPLE && eng_fit(NHEAVY, ENGI_MUUG) == ENGI_SAMPLE && eng_fit(NHEAVY, ENGI_PHYS) == ENGI_SAMPLE &&
+          eng_fit(NHEAVY, ENGI_LOFI) == ENGI_LOFI && eng_fit(0, ENGI_MUUG) == ENGI_MUUG && eng_fit(2, ENGI_PHYS) == ENGI_PHYS);
+    host_tracks_init();
+    check("1. the LITE part has no engine-state arena; the heavy parts have", !eng_arena_of(&trk[NHEAVY], ENGI_FM6) && eng_arena_of(&trk[0], ENGI_FM6) &&
+          eng_arena_of(&trk[2], ENGI_PHYS));
+
+    /* 2. every allowed engine sounds on it */
+    for (e = 1; e <= 5u; e++) {
+        ok = 1;
+        for (i = 0; i < 3u; i++) {
+            host_tracks_init();
+            host_preset(&trk[NHEAVY], e, i);
+            trk[NHEAVY].p[P_CHOR] = trk[NHEAVY].p[P_DLY] = trk[NHEAVY].p[P_REV] = 0;
+            render_part(NHEAVY, 52, ya, N);
+            ok &= rms(ya, 2000, N) > 20.0 && rms(ya, 2000, N) < 30000.0;
+        }
+        char what[96];
+        snprintf(what, sizeof what, "2. the LITE part plays %s (3 presets): sounds, bounded", NAMES[e - 1u]);
+        check(what, ok);
+    }
+
+    /* 3. independence from the other parts' random draws (each run in its own process: a fresh start, as tests/regress.c) */
+    {
+        uint32_t run;
+        double *out = mmap(0, 2u * sizeof ya, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+        for (run = 0; run < 2u; run++) {
+            pid_t pid = fork();
+            if (pid == 0) {
+                static int32_t b0[CTL], b3[CTL];
+                uint32_t blk, j;
+                double *o = out + run * N;
+                host_tracks_init();
+                host_preset(&trk[0], ENGI_PHYS, 2);
+                trk[0].p[P_LWAVE] = 4, trk[0].p[P_LRATE] = 110, trk[0].p[P_LD_PIT] = 40;
+                trk[0].p[P_CHOR] = trk[0].p[P_DLY] = trk[0].p[P_REV] = 0;
+                host_preset(&trk[NHEAVY], ENGI_DIGITAL, 0);
+                trk[NHEAVY].p[P_LWAVE] = 4;
+                trk[NHEAVY].p[P_LRATE] = (int16_t)(run ? 127 : 0);     /* its LFO wraps all the time / seldom: draws, or not */
+                trk_note_on(&trk[0], 50, 100);
+                trk_note_on(&trk[NHEAVY], 60, 100);
+                for (blk = 0; blk < N; blk += CTL) {
+                    track_render(&trk[NHEAVY], b3, CTL);        /* (the LITE part first: its draws come before the PHYS part's) */
+                    track_render(&trk[0], b0, CTL);
+                    for (j = 0; j < CTL && blk + j < N; j++)
+                        o[blk + j] = b0[j];
+                }
+                _exit(0);
+            }
+            waitpid(pid, 0, 0);
+        }
+        check("3. part 1 (PHYS, S&H LFO) is bit for bit the same whatever the LITE part's LFO draws", !memcmp(out, out + N, N * sizeof(double)) && rms(out, 2000, N) > 20.0);
+    }
+
+    /* 4. MIDI */
+    host_tracks_init();
+    song.g[G_CH1] = 1, song.g[G_CH2] = 2, song.g[G_CH3] = 3, song.g[G_DRCH] = 10, song.g[G_CHOTH] = 0;
+    check("4. channels: parts 1..3 as set, the drum track as set, the LITE part OFF (0xFF)",
+          trk_midi_ch(0) == 0u && trk_midi_ch(1) == 1u && trk_midi_ch(2) == 2u && trk_midi_ch(TRK_DRUM) == 9u && trk_midi_ch(NHEAVY) == 0xFFu);
+    ok = 1;
+    for (i = 0; i < 16u; i++) {
+        track_t *t = midi_own(i);
+        ok &= t != &trk[NHEAVY] && (i < 3u ? t == &trk[i] : i == 9u ? t == TDRUM : t == 0);
+    }
+    check("4. MIDI IN: channels 1, 2, 3 and 10 reach their tracks as in SLOOP; no channel is the LITE part's", ok);
+    song.g[G_CH2] = 4;                                                /* a user moves part 2 to channel 4: it follows, as always */
+    check("4. a synth part moved to channel 4 owns it", midi_own(3) == &trk[1] && midi_own(1) == 0);
+    song.g[G_CH2] = 2;
+
+    /* 5. the numbers outside: the editor's are the working ones; SLOOP's four (screen, project file) leave the LITE part out */
+    ok = 1;
+    for (k = 0; k < NTRK; k++)
+        ok &= trk_wire(k) == k && trk_of_wire(k) == k;
+    ok &= trk_of_wire(NTRK) == TRK_NOWIRE && TRK_WIRE_N == NTRK && NTRK == 5u && TRK_DRUM == NTRK - 1u;
+    check("5. the editor's tracks are the working ones: 5, the drum track the last (as INFO's ntrk says)", ok);
+    ok = 1;
+    for (k = 0; k < NTRK; k++)
+        ok &= trk_ui(k) == (k < NHEAVY ? k : k == TRK_DRUM ? 3u : TRK_NOWIRE);
+    for (i = 0; i < TRK_UI_N; i++)
+        ok &= trk_ui(trk_of_ui(i)) == i;
+    ok &= trk_of_ui(4) == TRK_NOWIRE && trk_ui(NHEAVY) == TRK_NOWIRE && TRK_UI_N == 4u;
+    check("5. SLOOP's four (pads, columns, project records): 1..3, then the drum track; the LITE part has none", ok);
+    check("5. a mask of tracks for the editor: the working bits, the drum track the 5th", ed_wire_bits(1u << TRK_DRUM) == 16u && ed_wire_bits(1u << NHEAVY) == 8u);
+
+    /* 6. a project */
+    {
+        static project_t q;
+        host_tracks_init();
+        trk[0].p[P_LEVEL] = 77;
+        trk[1].step[5].n = 1, trk[1].step[5].note[0] = 64, trk[1].step[5].time = ST_NOTE;
+        dstep_set(&TDRUM->dstep[3], 5, LV_NORM, 0);
+        trk[NHEAVY].step[2].n = 1, trk[NHEAVY].step[2].note[0] = 60, trk[NHEAVY].step[2].time = ST_NOTE;   /* (not stored yet) */
+        song.sel = TRK_DRUM;
+        proj_capture(&q);
+        check("6. a project is SLOOP's size still (4 records)", sizeof q == 3816u && PROJ_NTRK == 4u && sizeof q <= 4096u - 256u);   /* (a flash sector less its header) */
+        check("6. the selected drum track is record 3", q.sel == 3u);
+        check("6. record 0 holds part 1's level; record 3 the drum lanes", pt_get(&q.t[0], P_LEVEL) == 77 && dstep_has(&q.t[3].dstep[3], 5));
+        memset(trk[0].p, 0, sizeof trk[0].p);
+        trk[1].step[5].n = 0;
+        memset(TDRUM->dstep, 0, sizeof TDRUM->dstep);
+        host_preset(&trk[NHEAVY], ENGI_LOFI, 2);
+        song.sel = 0;
+        proj_apply(&q, 1);
+        check("6. a load puts back the heavy parts' level and steps, and the drum lanes",
+              trk[0].p[P_LEVEL] == 77 && trk[1].step[5].n == 1 && dstep_has(&TDRUM->dstep[3], 5));
+        check("6. the file's selected track (record 3) is the drum track again", proj_trk_of(q.sel) == TRK_DRUM && proj_trk_of(2) == 2u && proj_trk_of(9) == 0u);
+        check("6. the LITE part has its power-on sound (SAMPLE) and no steps after a load", trk[NHEAVY].eng_req == ENGI_SAMPLE && !trk[NHEAVY].step[2].n);
+    }
+
+    printf("lite: %s\n", bad ? "FAILED" : "all ok");
+    return bad ? 1 : 0;
+}
