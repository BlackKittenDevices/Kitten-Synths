+/* Kitten Synths (fix-23): the roofs under a header, a cat on one and the moon (at moon, my) over them, in the theme's faintest colours;
+ * drawn first, so the text and icons of the bar cover them. y1: the bottom row, the roofs 2..5 rows high; cat: its x (0 = none) */
+static void cv_roofs(int32_t y1, int32_t cat, int32_t moon, int32_t my)
+{
+    int32_t x = 0, i = 0, h, w, a, b;
+    for (a = -4; a <= 4; a++)                                           /* the moon */
+        for (b = -4; b <= 4; b++)
+            if (a * a + b * b <= 18)
+                cv_pset(moon + a, my + b, C_LINE);
+    while (x < 240) {
+        w = 8 + (i * 7) % 9;
+        h = 2 + (i * 5) % 4;
+        cv_rect(x, y1 - h + 1, w, h, C_LINE);
+        if (i & 1)
+            cv_pset(x + w / 2, y1 - h, C_LINE);                         /* a gable */
+        x += w + 1;
+        i++;
+    }
+    if (cat) {                                                          /* sitting, seen from behind, tail up */
+        cv_rect(cat, y1 - 5, 6, 5, C_DIM);
+        cv_rect(cat + 1, y1 - 9, 5, 4, C_DIM);
+        cv_pset(cat + 1, y1 - 10, C_DIM);
+        cv_pset(cat + 5, y1 - 10, C_DIM);
+        cv_rect(cat + 6, y1 - 8, 1, 4, C_DIM);
+        cv_pset(cat + 2, y1 - 8, C_HI);
+        cv_pset(cat + 4, y1 - 8, C_HI);
+    }
+}
+
+/* a cobweb in a graph strip's top right corner (a quarter of a wheel: 5 spokes, 4 rings) and a spider hanging from it;
+ * drawn from the strip's top row whatever the graph's own offset */
+static void cv_web(uint16_t c)
+{
+    static const int8_t W[5][2] = {{0, 44}, {-17, 41}, {-31, 31}, {-41, 17}, {-44, 0}};
+    int32_t j, k, o = -cv_oy;
+    for (j = 0; j < 5; j++)
+        cv_line(239, o, 239 + W[j][0], o + W[j][1], c);
+    for (k = 1; k <= 4; k++)
+        for (j = 0; j < 4; j++)
+            cv_line(239 + W[j][0] * k / 4, o + W[j][1] * k / 4, 239 + W[j + 1][0] * k / 4, o + W[j + 1][1] * k / 4, c);
+    cv_line(214, o, 214, o + 22, C_LINE);                               /* the thread, the spider's body and legs */
+    cv_rect(212, o + 22, 5, 4, C_DIM);
+    cv_line(209, o + 20, 212, o + 24, C_DIM);
+    cv_line(209, o + 27, 212, o + 25, C_DIM);
+    cv_line(220, o + 20, 217, o + 24, C_DIM);
+    cv_line(220, o + 27, 217, o + 25, C_DIM);
+}
+
 /* glyph index of a character: the screen shows capitals only (SLOOP 2.6: bold capitals read better on the
  * small screen), so lower case folds to upper case, Latin-1 too (\xfc -> \xdc; not the division sign, nor sharp
  * s and y diaeresis, which have none); anything missing (and C1 controls) draws as '?' */
