+def favicon_uri():
+    """the tab icon: the kitten on a black square, 64 x 64, in a data URI (it needs no file, so it also shows in the editor saved
+    as one file, in the simulator and with the site's service worker holding an older icon)"""
+    p = art()
+    if not p:
+        return None
+    from PIL import Image
+    cat = _native(p).crop(BOX)
+    w = 56
+    h = int(w * cat.height / cat.width)
+    sq = Image.new("RGB", (64, 64), (0, 0, 0))
+    sq.paste(cat.resize((w, h), Image.NEAREST), ((64 - w) // 2, (64 - h) // 2))
+    b = io.BytesIO()
+    sq.quantize(32).save(b, "PNG", optimize=True)
+    return "data:image/png;base64," + base64.b64encode(b.getvalue()).decode()
+
+
 def brand(html):
-    return html.replace(PLACEHOLDER, logo_uri())
+    html = html.replace(PLACEHOLDER, logo_uri())
+    fav = favicon_uri()
+    if fav and "</head>" in html:                   # the cat's icon, outside the PWA block (the one-file editor drops it)
+        html = html.replace("</head>", '<link rel="icon" type="image/png" href="' + fav + '">\n</head>', 1)
+    return html
 
 
