+/* Kitten Synths: the filter's response as the knobs move it. The axis is the cutoff knob (0..127 over 8..230 px, 16 px an octave),
+ * the height decibels (1 px = 1 dB, 0 dB at y 34): flat in the pass band, the slope past the cutoff (LP / HP; BP both sides at half)
+ * and the resonance's peak (res 0..127 = 0..18 dB, one octave wide), the cutoff marked with a thin line.
+ * type 0 LP, 1 BP, 2 HP; slope in dB per octave (0 = the filter is off) */
+UI_SMALL static void graph_filt(uint16_t c, uint32_t type, int32_t cut, int32_t res, int32_t slope)
+{
+    int32_t xc = 8 + cut + (cut * 3 >> 2), x, y, py = 34;
+    cv_rect(xc, 10, 1, 80, C_DIM);
+    for (x = 8; x < 232; x += 2) {
+        int32_t o = x - xc, ao = o < 0 ? -o : o, att = type == 1u ? ao * slope >> 5 : (type == 0u) == (o > 0) ? ao * slope >> 4 : 0;
+        y = 34 - (ao < 16 ? (res * 18 >> 7) * (16 - ao) >> 4 : 0) + att;
+        y = y > 91 ? 91 : y;
+        if (x > 8)
+            cv_line(x - 2, py, x, y, c);
+        py = y;
+    }
+    cv_line(0, 91, 239, 91, C_LINE);
+}
+
+UI_SMALL static void graph_adsr(const track_t *t, uint16_t c)
+{
+    graph_env(c, t->p[P_ATK], t->p[P_DEC], t->p[P_SUS], t->p[P_REL]);
+}
+
