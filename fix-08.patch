new file mode 100644
index 0000000..3f6c829
--- /dev/null
+++ b/tests/kitten_store_test.c
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Kitten Synths: the LITE part and the own MUUG patches beside a project (firmware/src/kitten_store.c) over a RAM flash.
+ *   build/host/kitten_store_test
+ * 1. a write of slot A and a load: the own patches and the LITE part come back; the other slots stay as they were.
+ * 2. several slots are independent (a write of B moves nothing of A; a rewrite of A with a different size keeps B).
+ * 3. a busy LITE part that does not fit the object: only the patches are saved (return 1), and the load says so.
+ * 4. no object / a bad magic: a load says -1 and changes nothing.
+ * 5. a torn write leaves the old object whole. */
+#define main hostsim_main
+#include <stddef.h>
+#include "hostsim.c"
+#undef main
+#define PROJ_HOST 1
+static uint32_t trk_def_engine(uint32_t i)
+{
+    static const uint8_t E[NHEAVY] = {0, 1, 3};
+    return i < NHEAVY ? E[i] : 0u;
+}
+#include "../firmware/src/project.c"
+#include "../firmware/hal/fm1_flash.h"
+
+static uint8_t nor[0x100000];
+static int fail_after = -1;
+static int st_read(uint32_t off, void *dst, uint32_t n) { memcpy(dst, nor + off, n); return 0; }
+static int st_erase(uint32_t off) { memset(nor + off, 0xFF, 4096); return 0; }
+static int st_prog(uint32_t off, const void *src, uint32_t n)
+{
+    const uint8_t *s = src;
+    uint32_t i;
+    if (fail_after == 0)
+        return -9;
+    if (fail_after > 0)
+        fail_after--;
+    for (i = 0; i < n; i++)
+        nor[off + i] &= s[i];
+    return 0;
+}
+#include "../firmware/src/storage.c"
+static union { project_t v6; uint8_t raw[4096]; } proj_tmp;
+static project_t autosave_buf;
+static int flash_ok = 1;
+#include "../firmware/src/kitten_store.c"
+
+static int bad;
+static void check(const char *what, int ok)
+{
+    printf("kitten: %-90s %s\n", what, ok ? "ok" : "FAIL");
+    bad += !ok;
+}
+static project_t pj;
+static void own(uint32_t k, uint8_t seed)
+{
+    uint8_t pt[FG_SIZE];
+    uint32_t i;
+    host_preset(&trk[k], ENGI_MUUG, 0);
+    for (i = 0; i < sizeof pt; i++)
+        pt[i] = (uint8_t)(i < FG_NUM ? (seed + i) & 63u : 0);
+    fmini_set_patch(k, pt);
+    trk[k].p[P_E7] = (int16_t)FMINI_OWN;
+}
+static void lite(uint8_t lvl, uint32_t steps)
+{
+    uint32_t i;
+    host_preset(&trk[NHEAVY], ENGI_DIGITAL, 2);
+    trk[NHEAVY].p[P_LEVEL] = lvl;
+    for (i = 0; i < steps; i++) {
+        trk[NHEAVY].step[i].n = 1;
+        trk[NHEAVY].step[i].note[0] = (uint8_t)(30 + (i * 7u) % 50u);
+        trk[NHEAVY].step[i].time = ST_NOTE;
+        trk[NHEAVY].micro[i] = (int8_t)(i % 9u) - 4;
+    }
+}
+int main(void)
+{
+    int r;
+    uint8_t a0[FG_NUM];
+    memset(nor, 0xFF, sizeof nor);
+    host_tracks_init();
+    memset(&pj, 0, sizeof pj);
+    pj.rsv[0] = 0x40;
+
+    check("4. nothing saved: a load says -1", ks_apply(0, &pj) == -1);
+
+    own(0, 5);
+    own(2, 9);
+    lite(55, 16);
+    memcpy(a0, fmini_patch[0], FG_NUM);
+    r = ks_write(0);
+    check("1. slot A written", r == 0);
+    host_tracks_init();
+    host_preset(&trk[0], ENGI_MUUG, 0);
+    trk[0].p[P_E7] = (int16_t)FMINI_OWN;
+    host_preset(&trk[2], ENGI_MUUG, 0);
+    trk[2].p[P_E7] = (int16_t)FMINI_OWN;
+    lite(99, 0);
+    check("1. a load of A: done", ks_apply(0, &pj) == 0);
+    check("1. ... the own patch of part 1 is back", !memcmp(fmini_patch[0], a0, FG_NUM));
+    check("1. ... the LITE part (level, notes, nudge)",
+          trk[NHEAVY].p[P_LEVEL] == 55 && trk[NHEAVY].step[5].n == 1 && trk[NHEAVY].step[5].note[0] == 30 + (5 * 7) % 50 &&
+          trk[NHEAVY].micro[5] == 5 % 9 - 4);
+
+    /* 2 */
+    own(0, 20);
+    memset(trk[NHEAVY].step, 0, sizeof trk[NHEAVY].step);
+    lite(33, 4);
+    check("2. slot B written", ks_write(1) == 0);
+    check("2. A rewritten with another size", (lite(77, 40), ks_write(0)) == 0);
+    own(0, 1);
+    lite(1, 0);
+    check("2. B loads its own", ks_apply(1, &pj) == 0 && trk[NHEAVY].p[P_LEVEL] == 33 && trk[NHEAVY].step[3].n == 1 &&
+                                 trk[NHEAVY].step[4].n == 0);
+    check("2. A loads its own (the new one)", ks_apply(0, &pj) == 0 && trk[NHEAVY].p[P_LEVEL] == 77 && trk[NHEAVY].step[39].n == 1);
+    check("2. the working project (slot 4) has no entry yet", ks_apply(4, &pj) == -1);
+    check("2. ... and writes one", ks_write(4) == 0 && ks_apply(4, &pj) == 0);
+
+    /* 3 */
+    {
+        uint32_t i, j;
+        int w;
+        uint32_t seed = 12345;
+        lite(60, 64);
+        for (i = 0; i < 64u; i++) {
+            trk[NHEAVY].step[i].n = 4;
+            for (j = 0; j < 4u; j++) {
+                seed = seed * 1103515245u + 12345u;
+                trk[NHEAVY].step[i].note[j] = (uint8_t)(seed >> 16);
+            }
+            trk[NHEAVY].micro[i] = (int8_t)(seed >> 8);
+        }
+        for (i = 0; i < 4u; i++)
+            if (ks_write(i) < 0)
+                break;
+        w = ks_write(2);
+        check("3. a room that is full: the patches alone are saved (1) or it fits (0), never an error", w == 0 || w == 1);
+        w = ks_apply(2, &pj);
+        check("3. ... and a load says so (1) or is whole (0)", w == 0 || w == 1);
+        check("3. A still loads", ks_apply(1, &pj) >= 0);
+    }
+
+    /* 5 */
+    {
+        uint8_t keep[4096];
+        host_tracks_init();
+        own(0, 3);
+        lite(10, 2);
+        check("5. a write", ks_write(0) == 0);
+        memcpy(keep, nor + 0xFB000, sizeof keep);
+        lite(11, 3);
+        check("5. before: loads", ks_apply(0, &pj) == 0);
+        fail_after = 2;
+        r = ks_write(0);
+        fail_after = -1;
+        check("5. a torn write reports the error", r < 0);
+        lite(1, 0);
+        r = ks_apply(0, &pj);
+        /* (one sector: no second copy; the object is lost whole, never half: the load says -1 and changes nothing) */
+        check("5. ... and the load is whole or refused (-1), the LITE part untouched when refused",
+              (r == 0 && (trk[NHEAVY].p[P_LEVEL] == 10 || trk[NHEAVY].p[P_LEVEL] == 11)) || (r == -1 && trk[NHEAVY].p[P_LEVEL] == 1));
+        check("5. a write after it works again", ks_write(0) == 0 && ks_apply(0, &pj) == 0);
+    }
+    printf("kitten: %s\n", bad ? "FAILED" : "all ok");
+    return bad;
+}
