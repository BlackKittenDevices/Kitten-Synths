diff --git a/firmware/src/kitten_store.c b/firmware/src/kitten_store.c
new file mode 100644
index 0000000..5d17a86
--- /dev/null
+++ b/firmware/src/kitten_store.c
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Kitten Synths: the LITE part and the MUUG patches of a project, in the flash object OBJ_KITTEN (included by project.c; the host
+ * test tests/kitten_store_test.c includes it with a RAM flash). Needs proj_tmp, autosave_buf, flash_ok, storage.c, eng_muug.c. */
+#ifndef UI_SMALL
+#define UI_SMALL
+#endif
+/* ---- Kitten Synths: what a project file has no room for, beside it (flash object OBJ_KITTEN, one sector).
+ * A project file (SLOOP's, 3816 of 3840 bytes) holds tracks 1..3 and the drums. The LITE part (the fourth synth) and the MUUG
+ * patches that are the part's own (SLOT = OWN) go in this object: one entry for each slot A..D and one for the working project
+ * (the autosave), saved with the project, loaded with it. The object: "KSC1", the five entries' lengths (u16, 0 = none), the entries
+ * one after the other (a mask of the patches, 3 x FG_NUM bytes, the LITE record run-length coded). Staged in proj_tmp; the record
+ * is built in autosave_buf (free outside autosave_tick: the callers check). */
+#define KS_MAGIC 0x4B534331u                   /* "KSC1" */
+#define KS_N 5u                                /* the slots A..D, then the working project */
+#define KS_TAB (4u + 2u * KS_N)
+#define KS_MAX 3800u                           /* the object's bytes at most (a sector's payload is 3840) */
+_Static_assert(KS_MAX <= ST_PAYLOAD_MAX && sizeof proj_tmp >= KS_MAX && sizeof autosave_buf >= 3u * sizeof(proj_trk_t),
+               "the Kitten object fits its sector and the stage; a new entry (the record and its coding) fits autosave_buf");
+UI_SMALL static uint32_t ks_hash(void)           /* the LITE part and the own patches as they are now (the autosave's change test) */
+{
+    const track_t *t = &trk[NHEAVY];
+    uint32_t h = proj_hash(t->p, sizeof t->p) * 31u + proj_hash(t->step, sizeof t->step), k;
+    h = (h * 31u + proj_hash(t->micro, sizeof t->micro)) * 31u + proj_hash(t->fill, sizeof t->fill);
+    h = (h * 31u + proj_hash(t->lock, sizeof t->lock)) * 31u + t->eng_req * 257u + t->preset;
+    for (k = 0; k < NHEAVY; k++)
+        if (trk[k].eng_req == ENGI_MUUG && trk[k].p[P_E7] == (int16_t)FMINI_OWN)
+            h = h * 31u + proj_hash(fmini_patch[k], FG_NUM) + k;
+    return h;
+}
+static void ks_move(uint8_t *d, const uint8_t *s, uint32_t n)   /* overlapping: memmove */
+{
+    if (d < s)
+        while (n--)
+            *d++ = *s++;
+    else
+        while (n--)
+            d[n] = s[n];
+}
+static uint32_t ks_len(const uint8_t *b, uint32_t i) { return (uint32_t)b[4u + 2u * i] | (uint32_t)b[5u + 2u * i] << 8; }
+static void ks_set_len(uint8_t *b, uint32_t i, uint32_t n) { b[4u + 2u * i] = (uint8_t)n; b[5u + 2u * i] = (uint8_t)(n >> 8); }
+UI_SMALL static uint32_t ks_off(const uint8_t *b, uint32_t i)   /* where entry i starts */
+{
+    uint32_t o = KS_TAB, k;
+    for (k = 0; k < i; k++)
+        o += ks_len(b, k);
+    return o;
+}
+UI_SMALL static int ks_stage(void)                /* the object into proj_tmp (a fresh one if there is none); 1 = it was there */
+{
+    uint8_t *b = (uint8_t *)&proj_tmp;
+    uint32_t m, k, tot = KS_TAB;
+    int n = st_load(OBJ_KITTEN, b, KS_MAX);
+    if (n >= (int)KS_TAB && (memcpy(&m, b, 4), m == KS_MAGIC)) {
+        for (k = 0; k < KS_N; k++)
+            tot += ks_len(b, k);
+        if (tot <= (uint32_t)n)
+            return 1;
+    }
+    memset(b, 0, KS_TAB);
+    m = KS_MAGIC;
+    memcpy(b, &m, 4);
+    return 0;
+}
+/* slot 0..3 / 4 = the working project: its entry from what plays now. 0 = saved, 1 = saved without the LITE record (no room left
+ * in the object), else an error */
+UI_SMALL static int ks_write(uint32_t slot)
+{
+    uint8_t *b = (uint8_t *)&proj_tmp, *e = (uint8_t *)&autosave_buf.t[1], mask = 0;
+    proj_trk_t *r = &autosave_buf.t[0];
+    uint32_t k, w, n, off, old, tot, tail;
+    int part = 0;
+    if (!flash_ok || slot >= KS_N)
+        return -1;
+    for (k = 0; k < NHEAVY; k++)
+        if (trk[k].eng_req == ENGI_MUUG && trk[k].p[P_E7] == (int16_t)FMINI_OWN) {
+            mask |= (uint8_t)(1u << k);
+            memcpy(e + 1u + k * FG_NUM, fmini_patch[k], FG_NUM);
+        }
+    e[0] = mask;
+    memset(r, 0, sizeof *r);
+    proj_trk_capture(r, NHEAVY);
+    w = ks_rle(e + KS_HDR, 2u * sizeof *r - KS_HDR, (const uint8_t *)r, sizeof *r);
+    n = KS_HDR + w;
+    ks_stage();
+    old = ks_len(b, slot);
+    for (tot = KS_TAB, k = 0; k < KS_N; k++)
+        tot += ks_len(b, k);
+    if (tot - old + n > KS_MAX) {                  /* no room: the patches alone */
+        n = KS_HDR;
+        part = 1;
+    }
+    if (tot - old + n > KS_MAX)
+        return -2;
+    off = ks_off(b, slot);
+    tail = tot - off - old;
+    ks_move(b + off + n, b + off + old, tail);     /* the entries after it move */
+    memcpy(b + off, e, n);
+    ks_set_len(b, slot, n);
+    k = st_save(OBJ_KITTEN, b, tot - old + n);
+    return k ? (int)k : part;
+}
+/* the entry of slot 0..4 into the working tracks: the own MUUG patches, then the LITE part. -1: no entry, 0: done,
+ * 1: done without the LITE record. Called with the transport stopped, as project_apply */
+UI_SMALL static int ks_apply(uint32_t slot, const project_t *p)
+{
+    const uint8_t *b = (const uint8_t *)&proj_tmp, *e;
+    proj_trk_t *r = &autosave_buf.t[0];
+    uint32_t k, len;
+    if (!flash_ok || slot >= KS_N || !ks_stage())
+        return -1;
+    len = ks_len(b, slot);
+    e = b + ks_off(b, slot);
+    if (len < KS_HDR)
+        return -1;
+    fm1_irq_off();
+    for (k = 0; k < NHEAVY; k++)
+        if ((e[0] >> k) & 1u && trk[k].eng_req == ENGI_MUUG && trk[k].p[P_E7] == (int16_t)FMINI_OWN) {
+            uint8_t pt[FG_SIZE];
+            memset(pt, 0, sizeof pt);
+            memcpy(pt, e + 1u + k * FG_NUM, FG_NUM);
+            fmini_set_patch(k, pt);
+            fmini_adopt(k);
+        }
+    fm1_irq_on();
+    if (len == KS_HDR || !ks_unrle((uint8_t *)r, sizeof *r, e + KS_HDR, len - KS_HDR))
+        return 1;
+    fm1_irq_off();
+    proj_apply_trk(p, NHEAVY, r);
+    fm1_irq_on();
+    return 0;
+}
